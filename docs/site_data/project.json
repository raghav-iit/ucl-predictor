      }
    ]
  },
  "data_status": "historical_results_and_match_centre_available",
  "export_note": "Research metrics are rounded from the saved backend evaluation export; historical match-centre predictions are loaded from historical_match_centre.json.",
  "dataset": {
    "row_count": 1497,
    "season_range": "2015/16–2025/26",
    "date_range": "2015-09-15 to 2026-05-30",
    "source": "OpenFootball Champions League Football.TXT main competition season files; qualifying excluded",
    "class_counts": {
      "home_win": 706,
      "draw": 298,
      "away_win": 493
    },
    "class_percentages": {
      "home_win": 47.2,
      "draw": 19.9,
      "away_win": 32.9
    }
  },
  "preprocessing": {
    "feature_names": [
      "historical team performance",
      "Elo difference",
      "last-five-match form"
    ],
    "feature_descriptions": [
      "Prior match counts; points, goals for/against, goal difference and win/draw rates; venue-specific history.",
      "Model A plus home-minus-away Elo difference; initial rating 1500, K=24, fixed +60 home advantage.",
      "Model B plus points and goal-difference per match over each team's latest up to five earlier UCL matches."
    ],
    "leakage_guards": [
      "same-day feature rows use state at start of date",
      "90-minute outcomes only",
      "imputation/scaling fit on training data only"
    ]
  },
  "evaluation": {
    "split_description": "Chronological; common test matches; one validation and one final period, not repeated rolling-origin evaluation.",
    "development_fit": {
      "matches": 744,
      "period": "2015/16–2020/21"
    },
    "validation": {
      "matches": 250,
      "period": "2021/22–2022/23"
    },
    "final_fit": {
      "matches": 994,
      "period": "2015/16–2022/23"
    },
    "test_period": {
      "matches": 503,
      "period": "2023/24–2025/26"
    },
    "metric_definitions": {
      "log_loss": "Primary: penalizes low probability on the observed class.",
      "brier_score": "Primary: average squared multiclass H/D/A probability error.",
      "accuracy": "Secondary hard-label accuracy.",
      "macro_f1": "Secondary unweighted mean class F1."
    },
    "selection_caveat": "C=0.003 selected using validation and applied consistently. Earlier C=1 final-test results had already been viewed; final test is not strictly pristine historically."
  },
  "models": [
    {
      "id": "BASELINE",
      "name": "Training class frequencies",
      "description": "Predict H/D/A frequencies calculated from the training period; majority class supplies the reference hard prediction."
    },
    {
      "id": "A",
      "name": "Team performance",
      "description": "Cumulative UCL performance and venue-specific history."
    },
    {
      "id": "B",
      "name": "A + Elo",
      "description": "Adds online Elo rating difference from prior 90-minute UCL results."
    },
    {
      "id": "C",
      "name": "B + recent form",
      "description": "Adds up to five latest prior UCL matches: points and goal difference per match."
    }
  ],
